# Memoria.ia Server V2
# Copy to .env. Never commit the resulting file.

MEMORIA_SERVER_PORT=8780
MEMORIA_SERVER_PROXY_TIMEOUT=30
MEMORIA_AUTOTEST_TIMEOUT=180
MEMORIA_SERVER_MAX_REQUEST_BYTES=10485760
MEMORIA_SERVER_ADMIN_USER=admin
MEMORIA_SERVER_ADMIN_PASSWORD=change-me-with-a-random-login-password
MEMORIA_SERVER_SESSION_HOURS=8
# Change to true only after HTTPS is active.
MEMORIA_SERVER_COOKIE_SECURE=false
# Server-owned operational state: identity, devices and audit log.
MEMORIA_SERVER_DATA_DIR=/data

# Persistent curiosity engine. Web evidence is quarantined from personal memory.
MEMORIA_CURIOSITY_ENABLED=true
# Continuous pacing: one cognitive cycle per 60 s. The hourly value is only an
# emergency fuse against runaway loops; it is not the normal learning budget.
MEMORIA_CURIOSITY_INTERVAL_SECONDS=60
MEMORIA_CURIOSITY_MAX_REQUESTS_HOUR=3600
MEMORIA_CURIOSITY_RANDOM_JUMP_RATE=0.10
MEMORIA_CURIOSITY_STAGNATION_LIMIT=3
MEMORIA_CURIOSITY_RESULTS_PER_SEARCH=5
MEMORIA_CURIOSITY_HTTP_TIMEOUT=12
MEMORIA_CURIOSITY_MAX_PAGE_BYTES=8388608
MEMORIA_CURIOSITY_TEXT_LIMIT=20000
MEMORIA_CURIOSITY_NOVELTY_THRESHOLD=0.25
MEMORIA_CURIOSITY_SEED=0
MEMORIA_CURIOSITY_SEARCH_URL=https://html.duckduckgo.com/html/?q=QUERY

# Raw structural ingest. The sidecar has no runtime network access: it reads
# server raw captures read-only and writes only its own checkpoint volume.
BIT_ANALYZE_INTERVAL_SECONDS=5
BIT_ANALYZE_MAX_RECORDS=100
BIT_ANALYZE_WINDOW_BYTES=4096
BIT_ANALYZE_HOP_BYTES=4096
BIT_ANALYZE_CHUNK_BYTES=65536
BIT_ANALYZE_LAYERS=2

# Bridge immutable StructuralEvent batches into Memoria.ia raw observation intake.
MEMORIA_STRUCTURAL_BRIDGE_ENABLED=true
MEMORIA_STRUCTURAL_BRIDGE_INTERVAL_SECONDS=5

MEMORIA_ORGANIZATION_ID=provider-example
MEMORIA_ORGANIZATION_NAME=Provider Example
MEMORIA_NODE_ID=memoria:provider-example:primary
MEMORIA_API_KEY=change-me-with-a-long-random-secret

MODEL_GATEWAY_TIMEOUT=120
MEMORIA_LLAMA_MODELS_DIR=./models
MEMORIA_LLAMA_MODEL_FILE=model.gguf
MEMORIA_LLAMA_MODEL_ALIAS=local-llama
MEMORIA_LLAMA_CONTEXT_SIZE=4096
MEMORIA_LLAMA_THREADS=4
# MEMORIA_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

MEMORIA_LLM_INPUT_USD_PER_MILLION=
MEMORIA_LLM_OUTPUT_USD_PER_MILLION=
MEMORIA_LICENSE_STATUS=not_configured
MEMORIA_LICENSE_ID=
MEMORIA_LICENSE_PLAN=early_access
MEMORIA_LICENSE_VALID_UNTIL=
MEMORIA_LICENSE_MAX_NODES=1
MEMORIA_LICENSE_CAPABILITIES=memory.read,memory.write,chat.use
MEMORIA_PUBLIC_KEY=
MEMORIA_CERTIFICATE_REF=
MEMORIA_CERTIFICATE_STATUS=not_configured
MEMORIA_CAPABILITIES=memory.read,memory.write

MEMORIA_COMMIT=fc515b98652bfbe3bbb9f701aa5545bc02b1baf1
BDR_COMMIT=d09914b85646353d8fd004ccf99e96a94fab9eef

BIT_ANALYZE_COMMIT=3d229dd72af5031b25baa3b069effa9791057977
