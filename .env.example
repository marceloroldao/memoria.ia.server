# Memoria.ia Server v0.1.0-alpha.1
# Copy to .env. Never commit the resulting file.

MEMORIA_SERVER_PORT=8780
MEMORIA_SERVER_PROXY_TIMEOUT=30
MEMORIA_SERVER_MAX_REQUEST_BYTES=10485760

MEMORIA_ORGANIZATION_ID=provider-example
MEMORIA_ORGANIZATION_NAME=Provider Example
MEMORIA_NODE_ID=memoria:provider-example:primary
MEMORIA_API_KEY=change-me-with-a-long-random-secret

# Initial version: mock, openai or gemini.
# A local OpenAI-compatible server can use provider=openai with a local OPENAI_BASE_URL.
MEMORIA_LLM_PROVIDER=mock
MEMORIA_LLM_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MEMORIA_LLM_INPUT_USD_PER_MILLION=
MEMORIA_LLM_OUTPUT_USD_PER_MILLION=

# Future external licensing boundary. Keep not_configured in this alpha.
MEMORIA_LICENSE_STATUS=not_configured
MEMORIA_LICENSE_ID=
MEMORIA_LICENSE_PLAN=early_access
MEMORIA_LICENSE_VALID_UNTIL=
MEMORIA_LICENSE_MAX_NODES=1
MEMORIA_LICENSE_CAPABILITIES=memory.read,memory.write,chat.use

MEMORIA_PUBLIC_KEY=
MEMORIA_CERTIFICATE_REF=
MEMORIA_CERTIFICATE_STATUS=not_configured
MEMORIA_CAPABILITIES=memory.read,memory.write

# Reproducible upstream revisions.
MEMORIA_COMMIT=162604240f22cfab6449ebe48f4eb764d6e76d0c
BDR_COMMIT=1f6b7ccbe16bdfed2f1b5dcebceb17887bf6916e
