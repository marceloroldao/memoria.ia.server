{
  "schema": "memoria-ia-server-release/v1",
  "version": "0.1.0-alpha.9",
  "channel": "private-alpha",
  "components": {
    "memoria.ia": {
      "version": "1.0.0rc2",
      "commit": "162604240f22cfab6449ebe48f4eb764d6e76d0c"
    },
    "resolutive-db": {
      "version": "1.1.0",
      "commit": "1f6b7ccbe16bdfed2f1b5dcebceb17887bf6916e"
    },
    "server-shell": {
      "version": "0.1.0-alpha.9",
      "features": [
        "login",
        "session-cookie",
        "logout",
        "login-rate-limit",
        "autonomous-relation-tests",
        "isolated-test-sessions",
        "markdown-test-report",
        "persistent-model-catalog",
        "instant-model-selection",
        "llama-default-endpoint",
        "atomic-model-activation"
      ]
    },
    "bdr-explorer": {
      "version": "0.1.0",
      "mode": "demo-read-only"
    },
    "@memoria-ia/admin": {
      "version": "0.4.0",
      "source": {
        "repository": "marceloroldao/memoria.ia",
        "branch": "product/windows-native-alpha",
        "commit": "2871dc4a90b9aaa393f1525245424e14e02aaca2"
      }
    },
    "model-gateway": {
      "version": "0.1.0",
      "providers": ["openai", "gemini", "llama"],
      "secret_storage": "local-file-0600-alpha"
    },
    "llama.cpp": {
      "mode": "optional-compose-profile",
      "profile": "local-llm"
    }
  },
  "deployment": {
    "method": "docker-compose",
    "entrypoint": "scripts/install.sh",
    "port": 8780
  },
  "maturity": "controlled-test-only"
}
